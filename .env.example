# Copia este archivo como ".env" y ajusta los valores. El archivo ".env" NO se sube a Git.

# Clave secreta de Django. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# True solo en tu computador; en un servidor real debe ser False
DEBUG=True

# Dominios permitidos, separados por comas
ALLOWED_HOSTS=localhost,127.0.0.1
